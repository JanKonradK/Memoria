{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technogg",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "technogg",
      // Run `npx wrangler d1 create technogg` and paste the id here.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    // Alert engine heartbeat — every 10 minutes.
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
