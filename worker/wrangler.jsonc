{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "void-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "void-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "ALERT_SWEEP_MAX_USERS": "5",
    "CLERK_FRONTEND_API": "https://clerk.technogg.app",
    "MASTER_KEY_VERSION": "1",
  },
  "triggers": {
    // Alert engine heartbeat — every 10 minutes.
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "void",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "void-production",
          "database_id": "088aacbb-c125-4d05-833c-10dc0a648669",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "https://void.jankonrad-kruszynski.workers.dev",
        "ALERT_SWEEP_MAX_USERS": "5",
        "CLERK_FRONTEND_API": "https://learning-flea-86.clerk.accounts.dev",
        "MASTER_KEY_VERSION": "1",
      },
    },
  },
}
