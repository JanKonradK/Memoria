# Local development only. Never commit worker/.dev.vars.
SYNC_TOKEN=replace-with-a-local-random-token
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# `openssl rand -base64 32`
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
MASTER_KEY_VERSION=1
# Set only while rotating, then remove after every row has the new key version.
PREVIOUS_MASTER_KEY=
