{
  "name": "techno-gg",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "app",
    "worker",
    "tui"
  ],
  "scripts": {
    "dev": "npm -w app run dev",
    "build": "npm -w app run build && npm run build:desktop",
    "build:desktop": "esbuild shared/src/merge.ts --bundle --platform=node --format=esm --outfile=desktop/dist/merge.mjs",
    "build:tui": "npm -w tui run build",
    "tg": "node tui/dist/tg.js",
    "test": "npm -w shared run test",
    "typecheck": "npm -w shared run typecheck && npm -w app run typecheck && npm -w worker run typecheck && npm -w tui run typecheck",
    "deploy": "npm -w app run build && npm -w worker run deploy",
    "icons": "node app/scripts/gen-icons.mjs",
    "ico": "node app/scripts/gen-ico.mjs",
    "install:desktop": "powershell -ExecutionPolicy Bypass -File desktop/Install-Shortcut.ps1"
  }
}
