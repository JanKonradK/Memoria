{
  "name": "memoria",
  "private": true,
  "version": "3.0.1",
  "workspaces": [
    "shared",
    "app"
  ],
  "scripts": {
    "dev": "npm -w app run dev",
    "build": "npm -w app run build && npm run build:desktop",
    "build:desktop": "esbuild desktop/shared-core.mjs --bundle --platform=node --format=esm --outfile=desktop/dist/shared-core.mjs",
    "build:android": "node scripts/build-android.mjs",
    "android:open": "cd app && cap open android",
    "test": "npm -w shared run test && npm -w app run test && npm run test:desktop",
    "test:desktop": "vitest run --config vitest.desktop.config.mjs",
    "pretest:desktop": "npm run build:desktop",
    "test:e2e": "npm -w app run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:events": "node scripts/export-event-feed.mjs --check",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run format:check && npm run check:events && npm run typecheck && npm test && npm run build && npm run check:pwa",
    "typecheck": "npm -w shared run typecheck && npm -w app run typecheck",
    "audit": "npm audit --audit-level=moderate",
    "icons": "node app/scripts/gen-mark.mjs && node app/scripts/gen-icons.mjs && node app/scripts/gen-ico.mjs",
    "ico": "node app/scripts/gen-ico.mjs",
    "install:desktop": "powershell -ExecutionPolicy Bypass -File desktop/Install-Shortcut.ps1",
    "build:single": "npm -w app run build:single",
    "package": "node scripts/package-release.mjs",
    "export:events": "node scripts/export-event-feed.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "check:native": "node scripts/check-native.mjs",
    "check:browser": "node scripts/check-browser-extension.mjs",
    "prepackage": "node node_modules/electron/install.js",
    "predesktop": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "44.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
