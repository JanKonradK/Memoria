<?xml version="1.0" encoding="utf-8"?>
<!-- Single game, 2×2: the coin in its dailies ring over the account, energy and time to full. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/single_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_row" />

    <TextView
        android:id="@+id/single_label"
        style="@style/WidgetLabel"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal" />

    <TextView
        android:id="@+id/single_energy"
        style="@style/WidgetEnergy"
        android:gravity="center_horizontal" />

    <TextView
        android:id="@+id/single_full"
        style="@style/WidgetFull"
        android:gravity="center_horizontal" />

    <Chronometer
        android:id="@+id/single_timer"
        style="@style/WidgetTimer"
        android:gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/single_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_single_gone"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
