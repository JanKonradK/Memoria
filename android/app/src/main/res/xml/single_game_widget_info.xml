<?xml version="1.0" encoding="utf-8"?>
<!-- One game, picked as the widget is placed: 2×2, or a 2×1 strip. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.memoria.tracker.SingleGameWidgetConfigActivity"
    android:description="@string/widget_single_description"
    android:initialLayout="@layout/widget_single"
    android:minWidth="110dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_single"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
