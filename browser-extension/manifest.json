{
  "manifest_version": 3,
  "name": "Memoria browser connector",
  "version": "3.0.1",
  "description": "Read HoYoLAB game notes in your signed-in Chrome or Edge browser and send them to your local Memoria app.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://api-account-os.hoyolab.com/*",
    "https://sg-public-api.hoyolab.com/*",
    "https://bbs-api-os.hoyolab.com/*",
    "https://sg-act-public-api.hoyolab.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Memoria browser connector",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hoyolab_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https://api-account-os.hoyolab.com https://sg-public-api.hoyolab.com https://bbs-api-os.hoyolab.com https://sg-act-public-api.hoyolab.com; base-uri 'none'; frame-src 'none'"
  }
}
