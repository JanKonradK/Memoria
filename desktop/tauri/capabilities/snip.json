{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "snip",
  "description": "The screen-capture snip window: Memoria's own snip page on the loopback server, which may only read the frozen screen and commit or cancel the snip.",
  "windows": ["screenshot-snip"],
  "remote": {
    "urls": ["http://127.0.0.1:17817/*", "http://127.0.0.1:17818/*", "http://127.0.0.1:17819/*"]
  },
  "permissions": [
    "core:default",
    "allow-screenshot-snip-data",
    "allow-screenshot-snip-commit",
    "allow-screenshot-snip-cancel"
  ]
}
