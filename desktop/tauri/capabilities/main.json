{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Memoria window, served by the app's own loopback server.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:17817/*", "http://127.0.0.1:17818/*", "http://127.0.0.1:17819/*"]
  },
  "permissions": [
    "core:default",
    "allow-launch-list",
    "allow-launch-choose",
    "allow-launch-clear",
    "allow-launch-start",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-presence-get",
    "allow-presence-set",
    "allow-presence-set-compact-shortcut",
    "allow-games-watch",
    "allow-game-notify",
    "allow-renderer-ready",
    "allow-close-result",
    "allow-open-external",
    "allow-notifications-status",
    "allow-notifications-test",
    "allow-notifications-settings",
    "allow-set-zoom",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-state",
    "allow-window-enter-compact",
    "allow-window-exit-compact",
    "allow-window-set-compact-pin",
    "allow-window-surface",
    "allow-connector-status",
    "allow-connector-hoyolab-login",
    "allow-connector-hoyolab-disconnect",
    "allow-connector-hoyolab-link",
    "allow-connector-hoyolab-refresh",
    "allow-connector-hoyolab-redeem",
    "allow-connector-hoyolab-checkin",
    "allow-connector-hoyolab-prefs",
    "allow-connector-gacha-scan",
    "allow-connector-screenshot-pick",
    "allow-connector-screenshot-watch-choose",
    "allow-connector-screenshot-watch-clear",
    "allow-connector-screenshot-captures-open",
    "allow-connector-screenshot-captures-clear",
    "allow-connector-skport-login",
    "allow-connector-skport-disconnect",
    "allow-connector-skport-link",
    "allow-connector-skport-refresh",
    "allow-connector-skport-prefs",
    "allow-connector-hoyolab-import-browser",
    "allow-connector-skport-import-browser",
    "allow-connector-browser-start",
    "allow-connector-browser-cancel",
    "allow-connector-browser-open-helper",
    "allow-connector-screenshot-capture",
    "allow-connector-screenshot-set-shortcut"
  ]
}
